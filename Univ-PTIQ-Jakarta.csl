<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="display-and-sort" page-range-format="chicago">
  <info>
    <title>Universitas PTIQ Jakarta</title>
    <title-short>PTIQ</title-short>
    <id>http://www.zotero.org/styles/universitas-ptiq-jakarta</id>
    <link href="http://www.zotero.org/styles/universitas-ptiq-jakarta" rel="self"/>
    <link href="http://www.chicagomanualofstyle.org/tools_citationguide.html" rel="documentation"/>
    <author>
      <name>Nur Ardhiansyah</name>
    </author>
    <contributor>
      <name>nurr_ree</name>
    </contributor>
    <category citation-format="note"/>
    <category field="generic-base"/>
    <summary>Format sitasi untuk penulisan tesis dan disertasi Pascasarjana Universitas PTIQ Jakarta. V26: Conference proceedings bibliography kembali memakai "dalam" agar seragam dengan footnote. V25: (a) Book section — hapus &quot;dalam&quot; ganda, kini satu &quot;dalam&quot; + editor (ed.) opsional + judul; titik setelah judul buku sebelum tempat di bibliography; (b) Book bibliography — titik setelah judul; (c) Conference proceedings bibliography — hapus &quot;dalam&quot; &amp; tempat/penerbit, pakai Tahun. V24: chapter &quot;dalam&quot;, koma subsequent, t.th. V23: proceeding dipisah; nama lengkap subsequent. Compatible dengan Mendeley Desktop dan Zotero.</summary>
    <updated>2026-08-09T10:30:00+07:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <locale xml:lang="id">
    <terms>
      <term name="editor" form="verb-short">ed.</term>
      <term name="editor" form="short">ed.</term>
      <term name="translator" form="verb-short">diterjemahkan oleh</term>
      <term name="translator" form="short">terj.</term>
      <term name="editortranslator" form="verb-short">ed. dan terj.</term>
      <term name="and">dan</term>
      <term name="et-al">et al.</term>
      <term name="page" form="short">hal.</term>
      <term name="page" form="long">halaman</term>
      <term name="in">dalam</term>
      <term name="accessed">Diakses pada</term>
      <term name="volume" form="short">Vol.</term>
      <term name="issue" form="short">No.</term>
      <term name="edition" form="short">ed.</term>
      <term name="section" form="short">sec.</term>
      <term name="no date" form="short">t.th.</term>
      <term name="presented at">dipresentasikan pada</term>
      <term name="version">versi</term>
    </terms>
    <style-options punctuation-in-quote="true"/>
  </locale>

  <locale xml:lang="en">
    <terms>
      <term name="editor" form="verb-short">ed.</term>
      <term name="translator" form="verb-short">trans.</term>
      <term name="editortranslator" form="verb-short">ed. and trans.</term>
      <term name="et-al">et al.</term>
      <term name="volume" form="short">Vol.</term>
    </terms>
    <style-options punctuation-in-quote="true"/>
  </locale>

  <macro name="contributors-note">
    <names variable="author" suffix=",">
      <name and="text" delimiter=", " delimiter-precedes-et-al="always"/>
      <et-al term="et-al" font-style="italic"/>
      <label form="short" prefix=", "/>
      <substitute>
        <names variable="editor" suffix=",">
          <name and="text" delimiter=", " delimiter-precedes-et-al="always"/>
          <et-al term="et-al" font-style="italic"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <names variable="translator" suffix=",">
          <name and="text" delimiter=", " delimiter-precedes-et-al="always"/>
          <et-al term="et-al" font-style="italic"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <text macro="title-note"/>
      </substitute>
    </names>
  </macro>

  <macro name="contributors-short">
    <names variable="author" suffix=",">
      <name form="long" and="text" delimiter=", " delimiter-precedes-et-al="always"/>
      <et-al term="et-al" font-style="italic"/>
      <substitute>
        <names variable="editor" suffix=",">
          <name form="long" and="text" delimiter=", " delimiter-precedes-et-al="always"/>
          <et-al term="et-al" font-style="italic"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <names variable="translator" suffix=",">
          <name form="long" and="text" delimiter=", " delimiter-precedes-et-al="always"/>
          <et-al term="et-al" font-style="italic"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <text macro="title-short"/>
      </substitute>
    </names>
  </macro>

  <macro name="contributors">
    <names variable="author" suffix=".">
      <name name-as-sort-order="first" and="text" sort-separator=", " delimiter=", " delimiter-precedes-last="always" delimiter-precedes-et-al="always"/>
      <et-al term="et-al" font-style="italic"/>
      <label form="short" prefix=" "/>
      <substitute>
        <names variable="editor" suffix=".">
          <name name-as-sort-order="first" and="text" sort-separator=", " delimiter=", " delimiter-precedes-last="always" delimiter-precedes-et-al="always"/>
          <et-al term="et-al" font-style="italic"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <names variable="translator" suffix=".">
          <name name-as-sort-order="first" and="text" sort-separator=", " delimiter=", " delimiter-precedes-last="always" delimiter-precedes-et-al="always"/>
          <et-al term="et-al" font-style="italic"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <text macro="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="editor-translator">
    <names variable="editor translator" delimiter=", ">
      <label form="verb-short" suffix=" "/>
      <name and="text" delimiter=", " delimiter-precedes-et-al="always"/>
      <et-al term="et-al" font-style="italic"/>
    </names>
  </macro>

  <macro name="container-contributors-note">
    <choose>
      <if type="chapter-DISABLED" match="any">
        <group delimiter=" ">
          <text term="in"/>
          <names variable="editor translator" delimiter=", ">
            <name and="text" delimiter=", " delimiter-precedes-et-al="always"/>
            <et-al term="et-al" font-style="italic"/>
            <label form="short" prefix=" (" suffix=")"/>
          </names>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="chapter-container-note">
    <group delimiter=" ">
      <text term="in"/>
      <choose>
        <if variable="editor translator" match="any">
          <names variable="editor translator" delimiter=", ">
            <name and="text" delimiter=", " delimiter-precedes-et-al="always"/>
            <et-al term="et-al" font-style="italic"/>
            <label form="short" prefix=" (" suffix=")"/>
          </names>
        </if>
      </choose>
      <text variable="container-title" font-style="italic"/>
    </group>
  </macro>

  <macro name="chapter-container">
    <group delimiter=" ">
      <text term="in"/>
      <choose>
        <if variable="editor translator" match="any">
          <names variable="editor translator" delimiter=", ">
            <name and="text" delimiter=", " delimiter-precedes-et-al="always"/>
            <et-al term="et-al" font-style="italic"/>
            <label form="short" prefix=" (" suffix=")"/>
          </names>
        </if>
      </choose>
      <text variable="container-title" font-style="italic"/>
    </group>
  </macro>

  <macro name="container-contributors">
    <choose>
      <if type="chapter-DISABLED" match="any">
        <group delimiter=" ">
          <text term="in" text-case="capitalize-first"/>
          <names variable="editor translator" delimiter=", ">
            <name and="text" delimiter=", " delimiter-precedes-et-al="always"/>
            <et-al term="et-al" font-style="italic"/>
            <label form="short" prefix=" (" suffix=")"/>
          </names>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="title-note">
    <choose>
      <if variable="title" match="none">
        <text variable="genre"/>
      </if>
      <else-if type="book" match="any">
        <text variable="title" font-style="italic"/>
      </else-if>
      <else-if type="thesis" match="any">
        <text variable="title" quotes="true"/>
      </else-if>
      <else-if type="article-journal article-magazine article-newspaper" match="any">
        <text variable="title" quotes="true"/>
      </else-if>
      <else-if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="any">
        <text variable="title" quotes="true"/>
      </else-if>
      <else>
        <text variable="title" quotes="true"/>
      </else>
    </choose>
  </macro>

  <macro name="title">
    <choose>
      <if variable="title" match="none">
        <text variable="genre"/>
      </if>
      <else-if type="book" match="any">
        <text variable="title" font-style="italic"/>
      </else-if>
      <else-if type="thesis" match="any">
        <text variable="title" quotes="true"/>
      </else-if>
      <else-if type="article-journal article-magazine article-newspaper" match="any">
        <text variable="title" quotes="true"/>
      </else-if>
      <else-if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="any">
        <text variable="title" quotes="true"/>
      </else-if>
      <else>
        <text variable="title" quotes="true"/>
      </else>
    </choose>
  </macro>

  <macro name="title-short">
    <choose>
      <if variable="title" match="none">
        <text variable="genre"/>
      </if>
      <else-if type="book" match="any">
        <text variable="title" form="short" font-style="italic"/>
      </else-if>
      <else-if type="thesis" match="any">
        <text variable="title" form="short" quotes="true"/>
      </else-if>
      <else>
        <text variable="title" form="short" quotes="true"/>
      </else>
    </choose>
  </macro>

  <macro name="container-title-note">
    <choose>
      <if type="article-journal">
        <group delimiter=" ">
          <text term="in"/>
          <text variable="container-title" font-style="italic"/>
        </group>
      </if>
      <else-if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="any">
        <group delimiter=" ">
          <text term="in"/>
          <text variable="container-title" font-style="italic"/>
        </group>
      </else-if>
      <else-if type="webpage post-weblog" match="any">
        <text variable="container-title"/>
      </else-if>
      <else>
        <text variable="container-title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <macro name="container-title">
    <choose>
      <if type="article-journal">
        <group delimiter=" ">
          <text term="in"/>
          <text variable="container-title" font-style="italic"/>
        </group>
      </if>
      <else-if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="any">
        <group delimiter=" ">
          <text term="in"/>
          <text variable="container-title" font-style="italic"/>
        </group>
      </else-if>
      <else-if type="webpage post-weblog" match="any">
        <text variable="container-title"/>
      </else-if>
      <else>
        <text variable="container-title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <macro name="edition-note">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <macro name="volume-book-note">
    <choose>
      <if type="book" match="any">
        <choose>
          <if variable="volume">
            <group delimiter=" ">
              <text value="vol."/>
              <text variable="volume"/>
            </group>
          </if>
        </choose>
      </if>
    </choose>
  </macro>

  <macro name="volume-book">
    <choose>
      <if type="book" match="any">
        <choose>
          <if variable="volume">
            <group delimiter=" ">
              <text value="vol."/>
              <text variable="volume"/>
            </group>
          </if>
        </choose>
      </if>
    </choose>
  </macro>

  <macro name="locators-note-journal">
    <choose>
      <if type="article-journal">
        <group delimiter=" ">
          <choose>
            <if variable="volume">
              <text variable="volume" prefix="Vol. "/>
            </if>
          </choose>
          <choose>
            <if variable="issue">
              <text variable="issue" prefix="No. "/>
            </if>
          </choose>
          <choose>
            <if variable="issued">
              <text macro="issued-year" prefix="Tahun "/>
            </if>
          </choose>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="locators-journal">
    <choose>
      <if type="article-journal">
        <group delimiter=" ">
          <choose>
            <if variable="volume">
              <text variable="volume" prefix="Vol. "/>
            </if>
          </choose>
          <choose>
            <if variable="issue">
              <text variable="issue" prefix="No. "/>
            </if>
          </choose>
          <choose>
            <if variable="issued">
              <text macro="issued-year" prefix="Tahun "/>
            </if>
          </choose>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="locators-newspaper">
    <choose>
      <if type="article-newspaper">
        <group delimiter=", ">
          <date variable="issued" form="text"/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="locators-magazine">
    <choose>
      <if type="article-magazine">
        <group delimiter=" ">
          <date variable="issued" form="text"/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="point-locators">
    <choose>
      <if variable="locator">
        <choose>
          <if locator="page" match="none">
            <label variable="locator" form="short" suffix=" "/>
          </if>
          <else>
            <choose>
              <if type="book">
                <text macro="volume-book-note" prefix=", "/>
              </if>
            </choose>
            <text term="page" form="short" prefix=", " suffix=" "/>
          </else>
        </choose>
        <text variable="locator"/>
      </if>
      <else-if type="chapter paper-conference article-journal article-magazine article-newspaper" match="any">
        <text variable="page" prefix=", hal. "/>
      </else-if>
      <else-if type="book">
        <text macro="volume-book-note" prefix=", "/>
      </else-if>
    </choose>
  </macro>

  <macro name="point-locators-subsequent">
    <choose>
      <if variable="locator">
        <choose>
          <if locator="page" match="none">
            <label variable="locator" form="short" prefix=", " suffix=" "/>
          </if>
          <else>
            <text term="page" form="short" prefix=", " suffix=" "/>
          </else>
        </choose>
        <text variable="locator"/>
      </if>
    </choose>
  </macro>

  <macro name="pages">
    <choose>
      <if type="chapter paper-conference article-journal article-magazine article-newspaper" match="any">
        <text variable="page" prefix=", hal. "/>
      </if>
    </choose>
  </macro>

  <macro name="subsequent-tail-book">
    <choose>
      <if variable="volume">
        <text value=" …, "/>
        <text macro="volume-book-note"/>
      </if>
    </choose>
  </macro>

  <macro name="subsequent-tail-general">
    <choose>
      <if variable="page">
        <text value=", …"/>
        <text variable="page" prefix=", hal. "/>
      </if>
    </choose>
  </macro>

  <macro name="publisher">
    <choose>
      <if type="thesis">
        <group delimiter=": ">
          <choose>
            <if variable="publisher-place">
              <text variable="publisher-place"/>
            </if>
            <else>
              <text value="t.tp."/>
            </else>
          </choose>
          <choose>
            <if variable="publisher">
              <text variable="publisher"/>
            </if>
            <else>
              <text value="t.p."/>
            </else>
          </choose>
        </group>
      </if>
      <else-if type="speech">
        <choose>
          <if variable="event-place">
            <text variable="event-place"/>
          </if>
          <else>
            <text value="t.tp."/>
          </else>
        </choose>
      </else-if>
      <else>
        <group delimiter=": ">
          <choose>
            <if variable="publisher-place">
              <text variable="publisher-place"/>
            </if>
            <else>
              <text value="t.tp."/>
            </else>
          </choose>
          <choose>
            <if variable="publisher">
              <text variable="publisher"/>
            </if>
            <else>
              <text value="t.p."/>
            </else>
          </choose>
        </group>
      </else>
    </choose>
  </macro>

  <macro name="publisher-year-combined">
    <choose>
      <if variable="publisher-place publisher issued" match="none">
        <text value="(t.d.)"/>
      </if>
      <else>
        <group delimiter=", ">
          <text macro="publisher"/>
          <text macro="issued"/>
        </group>
      </else>
    </choose>
  </macro>

  <macro name="issued">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any"/>
      <else-if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </else-if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>

  <macro name="issued-year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>

  <macro name="issued-full">
    <date variable="issued" form="text"/>
  </macro>

  <macro name="access-note">
    <choose>
      <if type="webpage post-weblog" match="any">
        <group delimiter=". ">
          <text variable="URL" prefix="dalam "/>
          <group delimiter=" ">
            <text term="accessed"/>
            <date variable="accessed" form="text"/>
            <text value="jam"/>
            <date variable="accessed" form="numeric">
              <date-part name="hour" form="numeric-leading-zeros" suffix="."/>
              <date-part name="minute" form="numeric-leading-zeros"/>
            </date>
          </group>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="access">
    <choose>
      <if type="webpage post-weblog" match="any">
        <group delimiter=". ">
          <text variable="URL" prefix="Dalam "/>
          <group delimiter=" ">
            <text term="accessed"/>
            <date variable="accessed" form="text"/>
            <text value="jam"/>
            <date variable="accessed" form="numeric">
              <date-part name="hour" form="numeric-leading-zeros" suffix="."/>
              <date-part name="minute" form="numeric-leading-zeros"/>
            </date>
          </group>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="genre-note">
    <choose>
      <if type="thesis">
        <text variable="genre" font-style="italic"/>
      </if>
    </choose>
  </macro>

  <macro name="genre">
    <choose>
      <if type="thesis">
        <text variable="genre" font-style="italic"/>
      </if>
    </choose>
  </macro>

  <citation et-al-min="3" et-al-use-first="1" et-al-subsequent-min="3" et-al-subsequent-use-first="1" disambiguate-add-names="true">
    <layout suffix="." delimiter="; ">
      <choose>
        <if position="ibid-with-locator ibid">
          <choose>
            <if variable="locator">
              <choose>
                <if type="thesis">
                  <group>
                    <text macro="contributors-short"/>
                    <text value=" "/>
                    <text variable="title" form="short" quotes="true"/>
                    <text value=" …, "/>
                    <text term="page" form="short" suffix=" "/>
                    <text variable="locator"/>
                  </group>
                </if>
                <else-if type="book">
                  <group>
                    <text macro="contributors-short"/>
                    <text value=" "/>
                    <text variable="title" form="short" font-style="italic" suffix=","/>
                    <text value=" …, "/>
                    <text macro="volume-book-note" suffix=", "/>
                    <text term="page" form="short" suffix=" "/>
                    <text variable="locator"/>
                  </group>
                </else-if>
                <else>
                  <group>
                    <text macro="contributors-short"/>
                    <text value=" "/>
                    <text variable="title" form="short" quotes="true" suffix=","/>
                    <text value=" …, "/>
                    <text term="page" form="short" suffix=" "/>
                    <text variable="locator"/>
                  </group>
                </else>
              </choose>
            </if>
            <else>
              <choose>
                <if type="thesis">
                  <group>
                    <text macro="contributors-short"/>
                    <text value=" "/>
                    <text variable="title" form="short" quotes="true"/>
                  </group>
                </if>
                <else-if type="book">
                  <group>
                    <text macro="contributors-short"/>
                    <text value=" "/>
                    <text variable="title" form="short" font-style="italic"/>
                    <text macro="subsequent-tail-book"/>
                  </group>
                </else-if>
                <else>
                  <group>
                    <text macro="contributors-short"/>
                    <text value=" "/>
                    <text variable="title" form="short" quotes="true"/>
                    <text macro="subsequent-tail-general"/>
                  </group>
                </else>
              </choose>
            </else>
          </choose>
        </if>
        <else-if position="subsequent">
          <choose>
            <if variable="locator">
              <choose>
                <if type="thesis">
                  <group>
                    <text macro="contributors-short"/>
                    <text value=" "/>
                    <text variable="title" form="short" quotes="true"/>
                    <text value=" …, "/>
                    <text term="page" form="short" suffix=" "/>
                    <text variable="locator"/>
                  </group>
                </if>
                <else-if type="book">
                  <group>
                    <text macro="contributors-short"/>
                    <text value=" "/>
                    <text variable="title" form="short" font-style="italic" suffix=","/>
                    <text value=" …, "/>
                    <text macro="volume-book-note" suffix=", "/>
                    <text term="page" form="short" suffix=" "/>
                    <text variable="locator"/>
                  </group>
                </else-if>
                <else>
                  <group>
                    <text macro="contributors-short"/>
                    <text value=" "/>
                    <text variable="title" form="short" quotes="true" suffix=","/>
                    <text value=" …, "/>
                    <text term="page" form="short" suffix=" "/>
                    <text variable="locator"/>
                  </group>
                </else>
              </choose>
            </if>
            <else>
              <choose>
                <if type="thesis">
                  <group>
                    <text macro="contributors-short"/>
                    <text value=" "/>
                    <text variable="title" form="short" quotes="true"/>
                  </group>
                </if>
                <else-if type="book">
                  <group>
                    <text macro="contributors-short"/>
                    <text value=" "/>
                    <text variable="title" form="short" font-style="italic"/>
                    <text macro="subsequent-tail-book"/>
                  </group>
                </else-if>
                <else>
                  <group>
